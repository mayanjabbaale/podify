# --- Required ---
DATABASE_URL=sqlite:///./storage/app.db
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
GEMINI_API_KEY=                 # free-tier key from Google AI Studio (restrict the key!)

# --- TTS ---
KOKORO_MODEL_DIR=./storage/models/kokoro
KOKORO_VOICE_HOST_A=af_bella    # warmer host
KOKORO_VOICE_HOST_B=am_adam     # matter-of-fact host
KOKORO_VOICE_NARRATOR=af_nicole # audiobook default

# --- App ---
APP_HOST=127.0.0.1              # never expose without auth
APP_PORT=8000
LOG_LEVEL=INFO

# --- Operations ---
RETENTION_DAYS=30               # episodes older than this are deleted by cleanup task
CELERY_TASK_TIME_LIMIT=1800     # 30 min hard cap per task

# --- Optional fallback (only if going fully offline instead of Gemini free tier) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
